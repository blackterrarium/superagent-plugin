# .superenv — superagent plugin defaults
# Precedence: env var > repo-root .superenv > this plugin default.
# Model values (Cursor build): a Cursor model name (see `agent --list-models`) or
# "inherit". "inherit" = omit the model override; the subagent runs on the session
# model. Any non-inherit value needs the per-role agent definition in .cursor/agents/
# — re-run superagent:init after changing one.
# (SUPER_MODEL_SUPERVISOR goes straight to `agent --model`, which takes any listed name.)

# ── Model per agent role ──────────────────────────────────────────
SUPER_MODEL_SUPERVISOR=inherit             # the superagent tick itself
SUPER_MODEL_PLANNER=inherit                # superplan / supergoal dispatch subagent
SUPER_MODEL_EXECUTOR=inherit               # superrun dispatch subagent (the SDD controller)
SUPER_MODEL_PANEL=inherit                  # L7 escalation panel (3 read-only agents)
SUPER_MODEL_IMPLEMENTER=inherit
SUPER_MODEL_FIX_APPLIER=inherit
SUPER_MODEL_TASK_REVIEWER=inherit
SUPER_MODEL_RE_REVIEWER=inherit
SUPER_MODEL_BRANCH_REVIEWER=inherit        # final whole-branch reviewer
SUPER_MODEL_FIX_PLANNER=inherit            # fix rounds 4-5: diagnose, then hand to fix-applier
SUPER_PANEL_AGENT_TYPE=general-purpose  # or: Explore

# ── Reasoning effort per agent role (NOT SUPPORTED on Cursor) ─────
# The Cursor CLI has no reasoning-effort control. Keys are kept for cross-harness
# .superenv portability; any non-inherit value is warned and treated as inherit.
SUPER_EFFORT_SUPERVISOR=inherit          # the superagent tick itself
SUPER_EFFORT_PLANNER=inherit               # superplan / supergoal dispatch subagent
SUPER_EFFORT_EXECUTOR=inherit            # superrun dispatch subagent (the SDD controller)
SUPER_EFFORT_PANEL=inherit                # L7 escalation panel (3 read-only agents)
SUPER_EFFORT_IMPLEMENTER=inherit
SUPER_EFFORT_FIX_APPLIER=inherit
SUPER_EFFORT_TASK_REVIEWER=inherit
SUPER_EFFORT_RE_REVIEWER=inherit
SUPER_EFFORT_BRANCH_REVIEWER=inherit      # final whole-branch reviewer
SUPER_EFFORT_FIX_PLANNER=inherit           # fix rounds 4-5: diagnose, then hand to fix-applier

# ── Harness ───────────────────────────────────────────────────────
SUPER_HARNESS=cursor                    # this is the Cursor build — the external driver fires the Cursor CLI (`agent`)

# ── Paths ─────────────────────────────────────────────────────────
SUPER_GOAL_ROOT=vault                   # goal folders land at <SUPER_GOAL_ROOT>/<STAMP>-<slug>/
SUPER_LOOP_STATUS_DIRNAME=loop-status   # gitignored; sibling of the goal's master-plans/

# ── Loop tuning ───────────────────────────────────────────────────
SUPER_HEAVY_STEP_LIMIT=6                # heavy skills per session before context handoff
SUPER_LOCK_STEAL_MIN=90                 # stale-lock steal window, minutes
SUPER_TICK_INTERVAL=10m                 # external-driver default when --interval omitted
SUPER_AUTO_DISARM_ON_DONE=true          # external driver: a tick that finds status DONE uninstalls its own scheduler entry (loop-status + env file kept); false = keep the timer polling
SUPER_INPUT_GATE=true                   # external driver: a tick that finds WAITING FOR INPUT with no `answer:` exits without launching a session (bash-only poll); false = launch the session every interval as before
SUPER_CI_GATE=true                      # external driver: a tick that finds WAITING FOR CI checks ci_wait.runs with `gh run view` in bash and exits without a session while any run is still running; false = launch the session every interval as before
SUPER_CI_MAX_WAIT_MIN=180               # external driver: once a WAITING FOR CI park (ci_wait.since) is older than this many minutes with runs still not completed, notify once (ci-stale) and let the session run each interval instead of gating; 0 = never (gate until every run is completed)
SUPER_NOTIFY_CMD=                       # external driver: shell snippet run when a loop parks on WAITING FOR INPUT, reaches DONE, or a CI park goes stale (SUPERAGENT_EVENT=waiting-for-input|done|ci-stale) (env: SUPERAGENT_EVENT SUPERAGENT_SLUG LOOP_FILE SUPERAGENT_TITLE SUPERAGENT_BODY), e.g. SUPER_NOTIFY_CMD='curl -s -d "$SUPERAGENT_BODY" -H "Title: $SUPERAGENT_TITLE" ntfy.sh/<topic>'; empty = desktop notification (osascript / notify-send) when available
#   SINGLE-quote the value: this file is *sourced* under `set -euo pipefail`, so an unquoted (or double-quoted) $SUPERAGENT_BODY expands when .superenv loads — before those variables exist — and aborts every tick with "unbound variable"; single quotes defer the expansion to notify time.
#   SUPERAGENT_BODY carries the loop's `## Pending decision` text, so the question itself reaches whatever endpoint the snippet targets (phone, Slack, pager).

# ── CI / test-evidence policy ─────────────────────────────────────
SUPER_TEST_EVIDENCE=local               # local = SDD's native TDD contract; ci = evidence is CI run ids only
SUPER_CI_FLAG_TEMPLATE=                 # commit-message flag grammar, e.g. "[test:%s]"; empty = none
SUPER_CI_ONE_FLAG_PER_PUSH=true
SUPER_CI_RUNNERS=1                      # >1 = queue independent long pushes back-to-back
SUPER_BRANCH_STYLE=flat                 # flat = no slashes in branch names

# ── Review protocol ───────────────────────────────────────────────
SUPER_REVIEW_CONFIDENCE_FILTER=controller  # reviewers report ALL findings with severity+confidence;
                                           # the controller filters. Never push the filter into the
                                           # reviewer prompt (Claude 5 reviewers silently drop findings).

# ── Git / PR policy ───────────────────────────────────────────────
SUPER_MERGE_METHOD=squash
SUPER_PROTECTED_MAIN=true               # all changes via PR from a feature branch
SUPER_ADMIN_MERGE=false                 # true only with session-scoped authorization
SUPER_SKIP_FINISHING_HANDOFF=false      # true = bypass superpowers:finishing-a-development-branch
SUPER_GH_DISABLE_SANDBOX=false          # true on macOS hosts where gh needs keychain access

# ── Escape hatch ──────────────────────────────────────────────────
SUPER_REPO_NOTES=                       # optional path to a repo doc the executor reads pre-run
