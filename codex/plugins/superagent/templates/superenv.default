# .superenv — superagent plugin defaults
# Precedence: env var > repo-root .superenv > this plugin default.
# Model values (Codex build): a Codex model name (e.g. gpt-5.6-sol) or "inherit".
# "inherit" = omit the model override; the CLI's config.toml default applies.
# Role pins dispatch as spawn_agent parameters — no agent-definition files on Codex.
# (SUPER_MODEL_SUPERVISOR goes straight to `codex exec -m`.)

# ── Model per agent role ──────────────────────────────────────────
SUPER_MODEL_SUPERVISOR=gpt-5.6-sol             # the superagent tick itself
SUPER_MODEL_PLANNER=gpt-5.6-sol                # superplan / supergoal dispatch subagent
SUPER_MODEL_EXECUTOR=gpt-5.6-sol               # superrun dispatch subagent (the SDD controller)
SUPER_MODEL_PANEL=gpt-5.6-sol                  # L7 escalation panel (3 read-only agents)
SUPER_MODEL_IMPLEMENTER=gpt-5.6-terra
SUPER_MODEL_FIX_APPLIER=gpt-5.6-terra
SUPER_MODEL_TASK_REVIEWER=gpt-5.6-sol
SUPER_MODEL_RE_REVIEWER=gpt-5.6-sol
SUPER_MODEL_BRANCH_REVIEWER=gpt-5.6-sol        # final whole-branch reviewer
SUPER_MODEL_FIX_PLANNER=gpt-5.6-sol            # fix rounds 4-5: diagnose, then hand to fix-applier
SUPER_PANEL_AGENT_TYPE=general-purpose  # or: Explore

# ── Reasoning effort per agent role ───────────────────────────────
# Values are Codex effort names, or "inherit" (= the CLI/model default).
#   codex: none | minimal | low | medium | high | xhigh
# SUPER_EFFORT_SUPERVISOR is passed at tick invocation (-c model_reasoning_effort).
# Any other non-inherit role key pins via the subagent-spawn parameter
# (reasoning_effort on spawn_agent).
SUPER_EFFORT_SUPERVISOR=medium          # the superagent tick itself
SUPER_EFFORT_PLANNER=high               # superplan / supergoal dispatch subagent
SUPER_EFFORT_EXECUTOR=medium            # superrun dispatch subagent (the SDD controller)
SUPER_EFFORT_PANEL=xhigh                # L7 escalation panel (3 read-only agents)
SUPER_EFFORT_IMPLEMENTER=medium
SUPER_EFFORT_FIX_APPLIER=medium
SUPER_EFFORT_TASK_REVIEWER=high
SUPER_EFFORT_RE_REVIEWER=high
SUPER_EFFORT_BRANCH_REVIEWER=xhigh      # final whole-branch reviewer
SUPER_EFFORT_FIX_PLANNER=high           # fix rounds 4-5: diagnose, then hand to fix-applier

# ── Harness ───────────────────────────────────────────────────────
SUPER_HARNESS=codex                    # this is the Codex build — the external driver fires the Codex CLI (codex exec)
SUPER_CODEX_SANDBOX=danger-full-access  # codex harness only: danger-full-access (no sandbox — claude-harness parity; workspace-write keeps .git/ read-only, breaking git fetch/commit) | workspace-write

# ── Paths ─────────────────────────────────────────────────────────
SUPER_GOAL_ROOT=vault                   # goal folders land at <SUPER_GOAL_ROOT>/<STAMP>-<slug>/
SUPER_LOOP_STATUS_DIRNAME=loop-status   # gitignored; sibling of the goal's master-plans/

# ── Loop tuning ───────────────────────────────────────────────────
SUPER_HEAVY_STEP_LIMIT=6                # heavy skills per session before context handoff
SUPER_LOCK_STEAL_MIN=90                 # stale-lock steal window, minutes
SUPER_TICK_INTERVAL=10m                 # external-driver default when --interval omitted
SUPER_AUTO_DISARM_ON_DONE=true          # external driver: a tick that finds status DONE uninstalls its own scheduler entry (loop-status + env file kept); false = keep the timer polling
SUPER_INPUT_GATE=true                   # external driver: a tick that finds WAITING FOR INPUT with no `answer:` exits without launching a session (bash-only poll); false = launch the session every interval as before
SUPER_NOTIFY_CMD=                       # external driver: shell snippet run when a loop parks on WAITING FOR INPUT or reaches DONE (env: SUPERAGENT_EVENT SUPERAGENT_SLUG LOOP_FILE SUPERAGENT_TITLE SUPERAGENT_BODY), e.g. SUPER_NOTIFY_CMD='curl -s -d "$SUPERAGENT_BODY" -H "Title: $SUPERAGENT_TITLE" ntfy.sh/<topic>'; empty = desktop notification (osascript / notify-send) when available
#   SINGLE-quote the value: this file is *sourced* under `set -euo pipefail`, so an unquoted (or double-quoted) $SUPERAGENT_BODY expands when .superenv loads — before those variables exist — and aborts every tick with "unbound variable"; single quotes defer the expansion to notify time.
#   SUPERAGENT_BODY carries the loop's `## Pending decision` text, so the question itself reaches whatever endpoint the snippet targets (phone, Slack, pager).

# ── CI / test-evidence policy ─────────────────────────────────────
SUPER_TEST_EVIDENCE=local               # local = SDD's native TDD contract; ci = evidence is CI run ids only
SUPER_CI_FLAG_TEMPLATE=                 # commit-message flag grammar, e.g. "[test:%s]"; empty = none
SUPER_CI_ONE_FLAG_PER_PUSH=true
SUPER_CI_RUNNERS=1                      # >1 = queue independent long pushes back-to-back
SUPER_BRANCH_STYLE=flat                 # flat = no slashes in branch names

# ── Review protocol ───────────────────────────────────────────────
SUPER_REVIEW_CONFIDENCE_FILTER=controller  # reviewers report ALL findings with severity+confidence;
                                           # the controller filters. Never push the filter into the
                                           # reviewer prompt (Claude 5 reviewers silently drop findings).

# ── Git / PR policy ───────────────────────────────────────────────
SUPER_MERGE_METHOD=squash
SUPER_PROTECTED_MAIN=true               # all changes via PR from a feature branch
SUPER_ADMIN_MERGE=false                 # true only with session-scoped authorization
SUPER_SKIP_FINISHING_HANDOFF=false      # true = bypass superpowers:finishing-a-development-branch
SUPER_GH_DISABLE_SANDBOX=false          # true on macOS hosts where gh needs keychain access

# ── Escape hatch ──────────────────────────────────────────────────
SUPER_REPO_NOTES=                       # optional path to a repo doc the executor reads pre-run
