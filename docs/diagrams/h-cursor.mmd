    SUP -- "shell: role-bridge.sh --tools executor" --> EX["EXECUTOR: fresh top-level agent -p<br/>runs superrun"]
    EX -- "Task tool ×N" --> SDD["6 SDD roles<br/>.cursor/agents/super-&lt;role&gt;.md when pinned"]
    SUP -- "Agent tool ×3 in one message" --> PAN["PANEL: 3 panelists"]
    subgraph BR["bridged role (any but supervisor / executor)"]
        REL["relay definition super-&lt;role&gt;.md<br/>model: SUPER_BRIDGE_RELAY_MODEL (default inherit)"] --> RB["role-bridge.sh → foreign CLI"]
    end
    PL -.-> REL
    SDD -.-> REL
